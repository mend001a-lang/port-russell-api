<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvelle réservation - Port Russell</title>
</head>
<body>

    <h1>Ajouter une réservation</h1>

    <form action="/reservations/create" method="POST">

        <p>
            <label for="catwayNumber">Numéro du catway :</label>
            <input type="number" id="catwayNumber"
                   name="catwayNumber" min="1" required>
        </p>

        <p>
            <label for="clientName">Nom du client :</label>
            <input type="text" id="clientName"
                   name="clientName" required>
        </p>

        <p>
            <label for="boatName">Nom du bateau :</label>
            <input type="text" id="boatName"
                   name="boatName" required>
        </p>

        <p>
            <label for="startDate">Date de début :</label>
            <input type="date" id="startDate"
                   name="startDate" required>
        </p>

        <p>
            <label for="endDate">Date de fin :</label>
            <input type="date" id="endDate"
                   name="endDate" required>
        </p>

        <button type="submit">Enregistrer la réservation</button>

    </form>

    <p>
        <a href="/reservations">Retour aux réservations</a>
    </p>

</body>
</html>