
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Port de Plaisance Russell</title>
</head>
<body>

    <header>
        <h1>Port de Plaisance Russell</h1>
    </header>

    <main>
        <section>
            <h2>Bienvenue à la capitainerie</h2>
            <p>
                Application de gestion des catways,
                des réservations et des utilisateurs du port.
            </p>
        </section>

        <section>
            <h2>Connexion</h2>

            <form action="/login" method="POST">
                <label for="email">Adresse email</label>
                <input type="email" id="email" name="email" required>

                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="password" required>

                <button type="submit">Se connecter</button>
            </form>
        </section>

        <section>
            <h2>Documentation</h2>
            <a href="/api-docs">Consulter la documentation API</a>
        </section>
    </main>

</body>
</html>
